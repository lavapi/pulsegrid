# Public origin users reach the app on.
PUBLIC_URL=http://localhost:3000

# Runtime connection: non-owner role, subject to row-level security.
DATABASE_URL=postgres://devdash_app:devdash_app_local@localhost:5432/devdash
# Migration connection: owns the schema.
MIGRATION_DATABASE_URL=postgres://devdash_owner:devdash_owner_local@localhost:5432/devdash
# Password assigned to the runtime role by the migration step.
APP_DB_PASSWORD=devdash_app_local

REDIS_URL=redis://localhost:6379
# true for a cluster-mode Redis or Valkey (e.g. ElastiCache with cluster mode on, shared with other applications):
# REDIS_URL is then its configuration endpoint, and every key carries the {REDIS_KEY_PREFIX} hash tag.
REDIS_CLUSTER=false
REDIS_KEY_PREFIX=dashops

SESSION_TTL_HOURS=8
API_PORT=4000
# Where the web app proxies /api requests.
API_URL=http://localhost:4000

# IAM role that connected accounts trust. Required to download the role template.

# Key that encrypts stored AWS access keys. Create one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me

# Google sign-in. Optional. The redirect URI is <PUBLIC_URL>/api/auth/google/callback.
# GOOGLE_CLIENT_ID=replace-me
# GOOGLE_CLIENT_SECRET=replace-me
