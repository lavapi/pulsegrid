{
  "name": "@pulsegrid/api",
  "version": "0.17.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file=../../.env dist/main.js\"",
    "dev:worker": "node --env-file=../../.env --watch dist/worker.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.cli.ts",
    "db:demo": "tsx --env-file=../../.env src/database/demo/seed-demo.cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1165.0",
    "@aws-sdk/client-cloudwatch": "^3.1165.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1165.0",
    "@aws-sdk/client-cost-explorer": "^3.1165.0",
    "@aws-sdk/client-ec2": "^3.1165.0",
    "@aws-sdk/client-ecs": "^3.1165.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1165.0",
    "@aws-sdk/client-elasticache": "^3.1165.0",
    "@aws-sdk/client-fis": "^3.1165.0",
    "@aws-sdk/client-iam": "^3.1165.0",
    "@aws-sdk/client-rds": "^3.1165.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/client-secrets-manager": "^3.1165.0",
    "@aws-sdk/client-service-quotas": "^3.1165.0",
    "@aws-sdk/client-sts": "^3.1165.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "2.0.2",
    "@pulsegrid/shared": "workspace:*",
    "bullmq": "^6.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "kysely": "^0.28.0",
    "otpauth": "9.4.0",
    "pg": "^8.13.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@smithy/types": "^4.19.0",
    "@swc/core": "^1.10.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "^6.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "supertest": "^7.0.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist"
  ]
}
